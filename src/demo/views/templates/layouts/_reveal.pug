extends _base.pug

block content
	block beforereveal
	.reveal(class=deck.class)
		block beforeslides
			+badge(plugin.name.toLowerCase())
		.slides
			block slides
		block afterslides

block append styles
	+revealsrc("style", "dist/reset.css")
	+revealsrc("style", "dist/reveal.css")
	+revealsrc("style", `dist/theme/${deck.theme}.css`)
	+revealsrc("style", "plugin/highlight/monokai.css")

	
	//- Demo styles
	if process.env.NODE_ENV === 'production'
		link(rel="stylesheet" href=`${base}assets/css/demo.css`)
	else
		link(rel="stylesheet" href="/src/demo/style/demo.scss")


block append scripts
	+revealsrc("script", "dist/reveal.js")
	+revealsrc("script", "plugin/highlight/highlight.js")
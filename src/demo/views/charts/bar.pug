extends ../templates/layouts/_reveal.pug

include ../slides/_mixins

append variables
	- base = '../'
	- presentation.title = 'Tablechart: Bar charts'

block slides
	include ../slides/_data

	section.title-slide
		h1.title Tablechart
		h3.subtitle for Reveal.js: Bar charts

	section
		h3 Names beside the bars
		p.small In a bar chart, the names are shown to the left of the bars. Use it when the names are long.
		.split
			+example({ lines: '7-8' })
				+chart({ type: 'bar', prefix: 'barbasic', title: 'Picked by variety', unit: 'thousands', rows: varietiessmall, code: 2 })

	section
		h3 Numbers
		p.small If a bar is long enough, its number is shown inside it. If not, the number is shown after the bar.
		.narrow
			+chart({ type: 'bar', prefix: 'barfit', title: 'Juice pressed by variety', unit: 'thousands of litres', rows: varieties })

	section
		h3 Grouped bars
		p.small If the table has more than one value column, each row is a group of bars. The column headers are the names in the legend.
		.split
			+example({ lines: '6,8-10' })
				+chart({ type: 'bar', prefix: 'bargroup', title: 'Apples sold by variety', unit: 'thousands', series: ['2022', '2026'], rows: sold })

	section
		h3 Step by step
		p.small Add #[code data-fragment] to the figure to show one bar per step.
		.split
			+example({ lines: '1' })
				+chart({ type: 'bar', prefix: 'barsteps', title: 'Picked by variety', unit: 'thousands', rows: varietiessmall, fragment: true })

	section
		h3 Grouped, step by step
		p.small With #[code data-fragment] on the figure, each step adds one group.
		.split
			+example({ lines: '1' })
				+chart({ type: 'bar', prefix: 'bargsteps', series: ['2022', '2026'], title: 'Apples sold by variety', unit: 'thousands', rows: sold, code: 2, fragment: true })

	section
		h3 Grouped, series by series
		p.small Add #[code data-fragment] to a column header to show that series in every group on a step.
		.split
			+example({ lines: '9-10' })
				+chart({ type: 'bar', prefix: 'bargseries', series: [{ name: '2022', fragment: true }, { name: '2026', fragment: true }], title: 'Apples sold by variety', unit: 'thousands', rows: sold, code: 2 })

	section
		h3 Grouped, one by one
		p.small Add #[code data-fragment] to every cell. The steps go down each column of the table: one series bar by bar, then the next.
		.split
			+example({ lines: '12-13,17-18' })
				+chart({ type: 'bar', prefix: 'bargcells', series: ['2022', '2026'], title: 'Apples sold by variety', unit: 'thousands', rows: sold, code: 2, cells: true })

	section
		h3 Stacked, step by step
		p.small With #[code data-fragment] on the figure, each step adds one stack.
		.split
			+example({ lines: '1' })
				+chart({ type: 'bar', prefix: 'barssteps', series: ['Farm shop', 'Market'], stack: true, title: 'Apples sold', unit: 'thousands', rows: soldBy, code: 2, fragment: true })

	section
		h3 Stacked, layer by layer
		p.small Add #[code data-fragment] to a column header to show that layer on every stack on a step.
		.split
			+example({ lines: '9-10' })
				+chart({ type: 'bar', prefix: 'barsseries', series: [{ name: 'Farm shop', fragment: true }, { name: 'Market', fragment: true }], stack: true, title: 'Apples sold', unit: 'thousands', rows: soldBy, code: 2 })

	section
		h3 Stacked, piece by piece
		p.small Add #[code data-fragment] to every cell. The steps go down each column of the table: the bottom layer piece by piece, then the next layer on top.
		.split
			+example({ lines: '12-13,17-18' })
				+chart({ type: 'bar', prefix: 'barscells', series: ['Farm shop', 'Market'], stack: true, title: 'Apples sold', unit: 'thousands', rows: soldBy, code: 2, cells: true })


block append scripts
	include ../slides/_init

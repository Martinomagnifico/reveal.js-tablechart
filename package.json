{
  "name": "reveal.js-tablechart",
  "version": "1.2.2",
  "description": "A Reveal.js plugin for simple charts: column, bar, line, waterfall and donut, with annotations. The data is an HTML or Markdown table.",
  "homepage": "https://github.com/martinomagnifico/reveal.js-tablechart",
  "type": "module",
  "author": {
    "name": "Martijn De Jongh (Martino)",
    "email": "martijn.de.jongh@gmail.com",
    "web": "https://martinomagnifico.github.io",
    "url": "https://martinomagnifico.github.io",
    "username": "martinomagnifico"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/martinomagnifico/reveal.js-tablechart.git"
  },
  "keywords": [
    "reveal.js",
    "reveal.js-plugin",
    "chart",
    "charts",
    "waterfall",
    "presentation",
    "svg",
    "dataviz"
  ],
  "main": "./plugin/tablechart/tablechart.js",
  "module": "./plugin/tablechart/tablechart.mjs",
  "style": "./plugin/tablechart/tablechart.css",
  "exports": {
    ".": {
      "import": "./plugin/tablechart/tablechart.mjs",
      "require": "./plugin/tablechart/tablechart.js"
    },
    "./plugin/*": "./plugin/*",
    "./tablechart.css": "./plugin/tablechart/tablechart.css",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/tablechart",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "npm run dev",
    "copy-reveal": "node scripts/copy-reveal.mjs",
    "copy-plugin": "node scripts/copy-plugin.mjs",
    "rename": "node scripts/rename.mjs",
    "dev": "vite",
    "prebuild": "rimraf demo plugin",
    "build-plugin": "vite build -c vite.lib.config.ts",
    "build-demo": "vite build -c vite.config.ts",
    "build": "npm run build-plugin && npm run build-demo && npm run copy-reveal && npm run copy-plugin",
    "prepublishOnly": "npm run build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "preview": "npm run build && vite preview",
    "ci": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "@vituum/vite-plugin-pug": "^2.0.1",
    "fs-extra": "^11.4.0",
    "reveal.js": "^5.2.1",
    "reveal.js-plugintoolkit": "^1.2.7",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vituum": "^2.0.2"
  },
  "dependencies": {
    "@martinomagnifico/tablechart": "^1.2.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  }
}
